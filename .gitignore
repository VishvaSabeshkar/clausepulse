@'
# ============================================================
# ClausePulse .gitignore
# Ignore secrets, generated files, machine-specific files.
# Never ignore /data (it IS the vector store).
# ============================================================

# ---------- Secrets (NEVER commit) ----------
.env
.env.*
!.env.example

# Firebase Admin service-account keys
*serviceAccount*.json
*service-account*.json
*firebase-adminsdk*.json

# ---------- Node / Next.js ----------
node_modules/
.next/
out/
build/
next-env.d.ts
*.tsbuildinfo
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------- Python ----------
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ---------- Vercel ----------
.vercel

# ---------- Testing ----------
coverage/

# ---------- OS / editor ----------
.DS_Store
Thumbs.db
*.pem
.idea/
.vscode/*
!.vscode/extensions.json
'@ | Set-Content -Path .gitignore -Encoding ascii
/local-docs/